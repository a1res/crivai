    "format:check": "prettier --check .",
    "check:locales": "node scripts/check-locales.mjs",
    "check:lockfile": "node scripts/check-lockfile.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run check:locales && npm run check:lockfile"
  },
  "dependencies": {
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
